# === 9-4 결정: Git + Git LFS (솔로 개발 단계, 팀원 합류 시 Perforce 전환 검토) ===
# .uasset/.umap은 바이너리라 일반 Git diff/merge가 의미 없음 -> LFS로 추적
# 지금부터 등록해두면 나중에 파일이 쌓인 뒤 LFS로 전환하는 마이그레이션 비용을 피할 수 있음

# 언리얼 핵심 애셋
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text

# 이미지
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text

# 사운드 (11-1 사운드 방향 결정에 따라 2개월차부터 실제로 쌓이기 시작)
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text

# 3D 모델/애니메이션 (5-11 Mixamo 리타겟 소스 등)
*.fbx filter=lfs diff=lfs merge=lfs -text

# 폰트
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text

# 압축파일 (참고 에셋 임포트 시)
*.zip filter=lfs diff=lfs merge=lfs -text
*.rar filter=lfs diff=lfs merge=lfs -text

# 텍스트 기반 파일은 LFS 대상에서 명시적으로 제외 (일반 Git 병합 그대로 사용, 4-3 참고)
*.cpp -filter=lfs diff -text
*.h -filter=lfs diff -text
*.cs -filter=lfs diff -text
*.uproject -filter=lfs diff -text
*.ini -filter=lfs diff -text
